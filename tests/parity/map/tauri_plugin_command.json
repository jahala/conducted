	"tauri_plugin_command:http|fetch": {
		"status": "matched",
		"ours": "tauri_command:http_fetch",
		"by": "hand",
		"note": "Starts an HTTP request through Tauri's HTTP plugin (main @2022870); ours makes the UI's HTTP requests with the http_fetch command. Stage 2 refuses the plugin: its calls go to Conductor's own servers or, with the run's network cut off, nowhere. Ours is shown by http.rs plat_30_fetch_returns_the_status_headers_and_body (ours allows only its listed hosts)."
	},
	"tauri_plugin_command:http|fetch_cancel": {
		"status": "matched",
		"ours": "tauri_command:http_cancel",
		"by": "hand",
		"note": "Cancels the plugin's request; ours is http_cancel. Ours is shown by http.rs plat_30_fetch_returns_the_status_headers_and_body (ours allows only its listed hosts)."
	},
	"tauri_plugin_command:http|fetch_send": {
		"status": "matched",
		"ours": "tauri_command:http_fetch",
		"by": "hand",
		"note": "Sends the request the plugin's fetch opened; ours sends it in the same http_fetch call. Ours is shown by http.rs plat_30_fetch_returns_the_status_headers_and_body (ours allows only its listed hosts)."
	},
	"tauri_plugin_command:http|fetch_read_body": {
		"status": "matched",
		"ours": "tauri_command:http_fetch",
		"by": "hand",
		"note": "Reads the body of the plugin's response; ours returns it with http_fetch's answer. Ours is shown by http.rs plat_30_fetch_returns_the_status_headers_and_body (ours allows only its listed hosts)."
	},
