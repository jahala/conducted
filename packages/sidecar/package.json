{
	"name": "@conducted/sidecar",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/main.ts"
	},
	"scripts": {
		"typecheck": "tsc -p .",
		"test": "bun test --timeout 60000 ${CONDUCTED_TEST_REPORTS:+--reporter=junit --reporter-outfile=$CONDUCTED_TEST_REPORTS/sidecar.xml}",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
		"build": "bun src/packaging.ts"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^2.5.0",
		"@anthropic-ai/claude-agent-sdk": "0.3.324",
		"@conducted/protocol": "workspace:^",
		"@conducted/shared": "workspace:^",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"json-rpc-2.0": "^1.8.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4"
	}
}
