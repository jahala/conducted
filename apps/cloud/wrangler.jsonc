// CLOUD-03. The user deploys this Worker to their own Cloudflare account; every resource it makes
// lives in that account. `wrangler deploy --name conducted-dev-<run>` names a throwaway copy.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "conducted-cloud",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"workers_dev": true,
	"vars": {
		// The smallest instance the sidecar and Claude Code fit in (spike, "Instance").
		"INSTANCE_TYPE": "basic"
	},
	"containers": [
		{
			"name": "conducted-cloud-sandbox",
			"class_name": "Workspace",
			"scheduling_policy": "durable_object",
			"images": {
				"sandbox": { "dockerfile": "./sandbox/Dockerfile" }
			}
		}
	],
	"durable_objects": {
		"bindings": [{ "class_name": "Workspace", "name": "WORKSPACE" }]
	},
	"exports": {
		"Workspace": { "type": "durable-object", "storage": "sqlite" }
	},
	// CLOUD-06: each workspace's latest backup of /workspace and the agents' transcript folders.
	// The user's deploy creates this bucket; deleting the Worker must delete it too.
	"r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "conducted-cloud-backups" }]
}
