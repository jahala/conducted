{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the main window may call from Tauri and its plugins. Only the plugins the UI uses are granted. The app's file and shell commands check their own path and program scopes, so the broad file-system and shell plugin defaults are not granted.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{ "url": "https://*" },
				{ "url": "http://*" },
				{ "url": "mailto:*" },
				{ "url": "linear://*" },
				{ "url": "vscode://*" },
				{ "url": "slack://*" },
				{ "url": "figma://*" },
				{ "url": "notion://*" },
				{ "url": "raycast://*" },
				{ "url": "x-apple.systempreferences:*" }
			]
		},
		"sql:default",
		"sql:allow-execute",
		"dialog:default",
		"notification:default",
		"clipboard-manager:default",
		"deep-link:default",
		"window-state:default",
		"core:window:allow-start-dragging"
	]
}
