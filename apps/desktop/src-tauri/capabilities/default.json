{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the main window may call. Keep this list as small as the features need.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"sql:default",
		"sql:allow-execute",
		"shell:default",
		"fs:default",
		"dialog:default",
		"notification:default",
		"clipboard-manager:default",
		"deep-link:default",
		"window-state:default"
	]
}
